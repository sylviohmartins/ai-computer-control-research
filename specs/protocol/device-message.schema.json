{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telechir.dev/schemas/device-message-0.1.schema.json",
  "title": "Telechir Device Message 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_type",
    "message_id",
    "device_id",
    "sequence",
    "sent_at",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "agent.hello",
        "agent.hello_ack",
        "heartbeat",
        "heartbeat_ack",
        "capabilities.changed",
        "command.request",
        "command.accepted",
        "command.chunk",
        "command.completed",
        "command.failed",
        "command.cancel",
        "command.cancelled",
        "approval.request",
        "approval.decision",
        "protocol.error"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "connection_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "agent.hello"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/agent_hello"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "agent.hello_ack"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/agent_hello_ack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "heartbeat"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/heartbeat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "heartbeat_ack"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/heartbeat_ack"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "capabilities.changed"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/capabilities_changed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.request"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.accepted"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.chunk"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_chunk"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.completed"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_completed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.failed"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_failed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.cancel"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_cancel"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "command.cancelled"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/command_cancelled"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "approval.request"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/approval_request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "approval.decision"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/approval_decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "message_type": {
            "const": "protocol.error"
          }
        },
        "required": [
          "message_type"
        ]
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "device-payloads.schema.json#/$defs/protocol_error"
          }
        }
      }
    }
  ]
}
