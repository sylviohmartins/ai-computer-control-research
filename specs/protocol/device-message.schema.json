{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telechir.dev/schemas/device-message-0.1.schema.json",
  "title": "Telechir Device Message 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_type",
    "message_id",
    "device_id",
    "sequence",
    "sent_at",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "agent.hello",
        "agent.hello_ack",
        "heartbeat",
        "heartbeat_ack",
        "capabilities.changed",
        "command.request",
        "command.accepted",
        "command.chunk",
        "command.completed",
        "command.failed",
        "command.cancel",
        "command.cancelled",
        "approval.request",
        "approval.decision",
        "protocol.error"
      ]
    },
    "message_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 128
    },
    "device_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "connection_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  }
}
